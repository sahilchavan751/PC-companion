<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.Processes"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TableHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="CategoryFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Toolbar -->
        <Grid Grid.Row="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 1: Page Title & Global Actions -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="TASK MANAGER &amp; MONITOR" Style="{StaticResource MetricLabelTextBlockStyle}" />
                    <TextBlock Text="Processes &amp; Services" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Real-time execution telemetry, thread metrics, and privileged process termination." FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- Actions: Live Pill, Refresh, End Task -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{StaticResource LiveBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AppSuccessBrush}" />
                            <TextBlock Text="LIVE 2s" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                        </StackPanel>
                    </Border>

                    <Button Command="{x:Bind ViewModel.RefreshProcessesCommand}" Padding="8,6" ToolTipService.ToolTip="Force Immediate Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.EndTaskCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedProcess, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.SelectedProcess, Mode=OneWay, Converter={StaticResource NullToBool}}"
                            Padding="12,6"
                            BorderBrush="#FF3D57"
                            ToolTipService.ToolTip="Terminate selected process (Del)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppErrorBrush}" />
                            <TextBlock Text="End Task" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppErrorBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 2: Search Box & Category Filters -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <AutoSuggestBox PlaceholderText="Filter by process name, PID, or publisher...  (Ctrl+F)"
                                Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Width="340" QueryIcon="Find" />

                <!-- Category Segmented Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CategoryFilterButtonStyle}" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="All">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="All" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="4,1">
                                <TextBlock Text="{x:Bind ViewModel.TotalProcessesCount, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppAccentBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryFilterButtonStyle}" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="Applications">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Apps" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="4,1">
                                <TextBlock Text="{x:Bind ViewModel.AppsCount, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppSuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryFilterButtonStyle}" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="Background">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Background" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="4,1">
                                <TextBlock Text="{x:Bind ViewModel.BackgroundCount, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CategoryFilterButtonStyle}" Command="{x:Bind ViewModel.SelectCategoryCommand}" CommandParameter="Windows">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Windows" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="4,1">
                                <TextBlock Text="{x:Bind ViewModel.WindowsCount, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Process List Table Card -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredProcesses, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                      SelectionMode="Single">

                <!-- Table Header with Sort Buttons -->
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="16,10" Background="#111111" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <!-- Name Column -->
                            <Button Style="{StaticResource TableHeaderButtonStyle}" Tag="Name" Click="OnSortColumnClick">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PROCESS NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                                </StackPanel>
                            </Button>

                            <!-- PID Column -->
                            <Button Grid.Column="1" Style="{StaticResource TableHeaderButtonStyle}" Tag="Id" Click="OnSortColumnClick">
                                <TextBlock Text="PID" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                            </Button>

                            <!-- Type Column -->
                            <TextBlock Grid.Column="2" Text="TYPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />

                            <!-- CPU Column -->
                            <Button Grid.Column="3" Style="{StaticResource TableHeaderButtonStyle}" Tag="Cpu" Click="OnSortColumnClick">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource AppAccentBrush}" />
                                </StackPanel>
                            </Button>

                            <!-- Memory Column -->
                            <Button Grid.Column="4" Style="{StaticResource TableHeaderButtonStyle}" Tag="Memory" Click="OnSortColumnClick">
                                <TextBlock Text="MEMORY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                            </Button>

                            <!-- Status Column -->
                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />

                            <!-- Actions Column -->
                            <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <!-- Process Item Row Template -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessItem">
                        <Grid Padding="16,8">
                            <!-- Context Menu for Right Click -->
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="End Task" Click="OnEndTaskItemClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource AppErrorBrush}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Restart Process" Click="OnRestartTaskItemClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Open File Location" Click="OnOpenFileLocationClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Set Priority">
                                        <MenuFlyoutItem Text="Realtime" Tag="RealTime" Click="OnSetPriorityItemClick" />
                                        <MenuFlyoutItem Text="High" Tag="High" Click="OnSetPriorityItemClick" />
                                        <MenuFlyoutItem Text="Above Normal" Tag="AboveNormal" Click="OnSetPriorityItemClick" />
                                        <MenuFlyoutItem Text="Normal" Tag="Normal" Click="OnSetPriorityItemClick" />
                                        <MenuFlyoutItem Text="Below Normal" Tag="BelowNormal" Click="OnSetPriorityItemClick" />
                                        <MenuFlyoutItem Text="Low" Tag="Idle" Click="OnSetPriorityItemClick" />
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Actual App Icon & Name / Subtitle -->
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Actual Process Icon with Fallback -->
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Image Source="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource FilePathToImage}}" 
                                           Width="20" Height="20"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    
                                    <Border Background="#16181D" BorderBrush="#262C38" BorderThickness="1" CornerRadius="2" Width="20" Height="20"
                                            Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                        <FontIcon Glyph="&#xE718;" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Process Identity -->
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    <TextBlock Text="{x:Bind SubtitleText}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Column 1: PID -->
                            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="2" Padding="6,2">
                                <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </Border>

                            <!-- Column 2: Category Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#161A22" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="2" Padding="5,1">
                                <TextBlock Text="{x:Bind CategoryCode}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" CharacterSpacing="40" />
                            </Border>

                            <!-- Column 3: CPU Usage -->
                            <TextBlock Grid.Column="3" Text="{x:Bind CpuFormatted, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />

                            <!-- Column 4: Memory (Working Set) -->
                            <TextBlock Grid.Column="4" Text="{x:Bind MemoryFormatted, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" />

                            <!-- Column 5: Status -->
                            <Border Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="2" Padding="6,2"
                                    Background="{x:Bind StatusText, Converter={StaticResource StateToBrush}}">
                                <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#0A0A0A" />
                            </Border>

                            <!-- Column 6: Quick Row Actions -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Padding="6,4" ToolTipService.ToolTip="End Task" Click="OnEndTaskItemClick">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppErrorBrush}" />
                                </Button>
                                <Button Padding="6,4" ToolTipService.ToolTip="Open File Location" Click="OnOpenFileLocationClick">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
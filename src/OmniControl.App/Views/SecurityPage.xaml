<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- 3 Security Pillars -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Antivirus Card -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="ANTIVIRUS PROTECTION" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <FontIcon Glyph="&#xE8D5;" HorizontalAlignment="Right" Foreground="{StaticResource AppSuccessBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.AntivirusName, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <Border Background="#107C41" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.AntivirusActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Active &amp; Protected" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Firewall Card -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="WINDOWS FIREWALL" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <FontIcon Glyph="&#xEA18;" HorizontalAlignment="Right" Foreground="{StaticResource AppAccentBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.FirewallText, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <Border Background="#107C41" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.FirewallActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Profiles Active" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- UAC Card -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="USER ACCOUNT CONTROL" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <FontIcon Glyph="&#xE7EF;" HorizontalAlignment="Right" Foreground="{StaticResource AppAccentBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.UacText, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <Border Background="#107C41" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.UacActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Elevation Shield Active" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recommendations Section -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SECURITY RECOMMENDATIONS &amp; AUDIT" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="Automated posture inspection of system integrity and defense mechanisms" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Border Style="{StaticResource LiveBadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" />
                                    <TextBlock Text="Live Security (2s)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                </StackPanel>
                            </Border>
                            <Button Command="{x:Bind ViewModel.RefreshSecurityStatusCommand}" ToolTipService.ToolTip="Force Re-scan" Padding="8,6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="#161B26" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#2A344A" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AppSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind}" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

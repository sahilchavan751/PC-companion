<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.Hardware"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- Diagnostics Cards Grid -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Ping Test Card -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PING LATENCY DIAGNOSTICS" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.PingTarget, Mode=TwoWay}" PlaceholderText="Host (e.g. 1.1.1.1 or google.com)" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RunPingCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                    <TextBlock Text="Run Ping" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Background="#161B26" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{x:Bind ViewModel.PingResultText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DNS Lookup Card -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="DNS RESOLUTION TEST" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.DnsTarget, Mode=TwoWay}" PlaceholderText="Domain (e.g. microsoft.com)" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RunDnsLookupCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Resolve DNS" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Background="#161B26" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{x:Bind ViewModel.DnsResultText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Network Adapters List -->
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="NETWORK ADAPTERS" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource LiveBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AppSuccessBrush}" />
                                <TextBlock Text="Real-time (2s)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Command="{x:Bind ViewModel.RefreshAdaptersCommand}" Padding="8,6" CornerRadius="8" ToolTipService.ToolTip="Force Immediate Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Adapters, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkAdapterMetric">
                            <Border Style="{StaticResource FluentInteractiveCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#1E293B" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE839;" Foreground="{StaticResource AppAccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                            <Border CornerRadius="4" Padding="6,1" Background="{x:Bind Status, Converter={StaticResource StateToBrush}}">
                                                <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <Border Background="#2A344A" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{x:Bind InterfaceType}" FontSize="10" Foreground="{StaticResource AppAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="IPv4:" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind Ipv4Address}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Gateway:" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind Gateway}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="MAC:" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind MacAddress}" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{x:Bind BytesReceived, ConverterParameter='Received: ', Converter={StaticResource FormatBytes}}" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind BytesSent, ConverterParameter='Sent: ', Converter={StaticResource FormatBytes}}" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

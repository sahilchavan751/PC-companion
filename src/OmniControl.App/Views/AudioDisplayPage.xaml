<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.AudioDisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.AudioDisplay"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- Audio Master Controls Card -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="MASTER AUDIO CONTROL" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="Control system-wide Windows Core Audio endpoint volume" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Border Style="{StaticResource LiveBadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" />
                                    <TextBlock Text="Live Real-time (2s)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                </StackPanel>
                            </Border>
                            <Button Command="{x:Bind ViewModel.LoadAudioAndDisplayCommand}" ToolTipService.ToolTip="Refresh Audio &amp; Display" Padding="8,6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <Button Command="{x:Bind ViewModel.ToggleMasterMuteCommand}" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.MasterMuteGlyph, Mode=OneWay}" 
                                      FontSize="16" Foreground="{StaticResource AppAccentBrush}" />
                        </Button>

                        <Slider Grid.Column="1" Minimum="0" Maximum="100" 
                                Value="{x:Bind ViewModel.MasterVolume, Mode=TwoWay}"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MasterVolumeText, Mode=OneWay}" 
                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Per-Application Audio Mixer -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="PER-APPLICATION VOLUME MIXER" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <TextBlock Text="Adjust audio levels individually for each running desktop application." FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.AudioSessions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioSessionItem">
                                <Grid Padding="0,8" BorderBrush="#1E2638" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="PID: " FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                                            <TextBlock Text="{x:Bind ProcessId}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnToggleAppMuteClick">
                                        <FontIcon Glyph="&#xE74F;" FontSize="12" Foreground="{StaticResource AppAccentBrush}" />
                                    </Button>

                                    <Slider Grid.Column="2" Minimum="0" Maximum="100" 
                                            Value="{x:Bind VolumePercent, Mode=OneTime}" 
                                            ValueChanged="OnAppVolumeChanged"
                                            VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <TextBlock Grid.Column="3" Text="{x:Bind VolumePercent}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Display Brightness Control -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="DISPLAY BRIGHTNESS" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.BrightnessStatusText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE706;" FontSize="18" Foreground="{StaticResource AppWarningBrush}" VerticalAlignment="Center" />

                        <Slider Grid.Column="1" Minimum="0" Maximum="100" 
                                Value="{x:Bind ViewModel.DisplayBrightness, Mode=TwoWay}"
                                ValueChanged="OnBrightnessSliderValueChanged"
                                IsEnabled="{x:Bind ViewModel.IsBrightnessSupported, Mode=OneWay}"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DisplayBrightnessText, Mode=OneWay}" 
                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

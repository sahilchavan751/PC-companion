<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.EnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.Environment"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- Scope Selector Toolbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnSwitchToUserScopeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;" FontSize="12" />
                            <TextBlock Text="User Variables" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSwitchToMachineScopeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="12" />
                            <TextBlock Text="System Variables (Requires Admin)" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border Style="{StaticResource LiveBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="#10B981" />
                            <TextBlock Text="Live (2s)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                    <Button Command="{x:Bind ViewModel.RefreshDataCommand}" ToolTipService.ToolTip="Refresh Environment Variables" Padding="8,6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- PATH Entries Manager Section -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="PATH ENVIRONMENT VARIABLE EDITOR" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="Entries are executed from top to bottom. Order determines resolution priority." FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Add Path Input -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox PlaceholderText="Enter new folder path (e.g. C:\Tools\bin)..." 
                                 Text="{x:Bind ViewModel.NewPathEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.AddPathItemCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add Path" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Paths List -->
                    <ListView ItemsSource="{x:Bind ViewModel.PathEntries, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPathItem, Mode=TwoWay}"
                              MaxHeight="320">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PathItem">
                                <Grid Padding="8,6" BorderBrush="#1E2638" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind Index}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AppTextMutedBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Path}" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="#3B2610" CornerRadius="3" Padding="4,1" Visibility="{x:Bind IsDuplicate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Duplicate Entry" FontSize="10" Foreground="{StaticResource AppWarningBrush}" />
                                            </Border>
                                            <Border Background="#3E1A1A" CornerRadius="3" Padding="4,1" Visibility="{x:Bind Exists, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="Path Does Not Exist" FontSize="10" Foreground="{StaticResource AppErrorBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                                        <Button ToolTipService.ToolTip="Move Up" Click="OnMovePathUpClick">
                                            <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                        </Button>
                                        <Button ToolTipService.ToolTip="Move Down" Click="OnMovePathDownClick">
                                            <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                        </Button>
                                    </StackPanel>

                                    <Button Grid.Column="3" ToolTipService.ToolTip="Remove Path" Click="OnRemovePathClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppErrorBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- All Environment Variables Table -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="ALL ENVIRONMENT VARIABLES" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <!-- Add Variable Row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox PlaceholderText="Variable Name..." 
                                 Text="{x:Bind ViewModel.NewVarName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" PlaceholderText="Variable Value..." 
                                 Text="{x:Bind ViewModel.NewVarValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="2" Command="{x:Bind ViewModel.AddVariableCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Save Variable" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Variables, Mode=OneWay}" MaxHeight="350">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EnvVariableItem">
                                <Grid Padding="8,8" BorderBrush="#1E2638" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <Button Grid.Column="2" ToolTipService.ToolTip="Delete Variable" Click="OnDeleteVariableClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppErrorBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.Storage"
    xmlns:hw="using:OmniControl.Core.Models.Hardware"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SegmentedModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickJumpChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="BorderBrush" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16">
            <!-- Top Header & Global Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="STORAGE &amp; VOLUME TELEMETRY" Style="{StaticResource MetricLabelTextBlockStyle}" />
                    <TextBlock Text="Storage &amp; Disk Space Analyzer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Deep allocation analysis, hidden system files, volume hierarchy, and safe cache purging." FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- Actions: Live Pill, Recycle Bin, Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{StaticResource LiveBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AppSuccessBrush}" />
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                        </StackPanel>
                    </Border>

                    <!-- Recycle Bin Button with live badge -->
                    <Button Command="{x:Bind ViewModel.EmptyRecycleBinCommand}" Padding="10,6" ToolTipService.ToolTip="Empty Recycle Bin">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppErrorBrush}" />
                            <TextBlock Text="Bin:" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RecycleBinSize, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.RefreshDrivesCommand}" Padding="8,6" ToolTipService.ToolTip="Refresh All Drives">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Drives Cards Grid -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="hw:DiskDriveInfo">
                        <Button Style="{StaticResource SegmentedModeButtonStyle}" 
                                Click="OnDriveCardClick" 
                                Tag="{x:Bind}" 
                                MinWidth="260" 
                                Padding="12,10"
                                HorizontalContentAlignment="Stretch">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top: Drive Letter, Label, System Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="{x:Bind DriveLetter}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind VolumeLabel}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#161A22" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="2" Padding="4,1"
                                            Visibility="{x:Bind IsSystemDrive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="BOOT / SYSTEM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" CharacterSpacing="30" />
                                    </Border>
                                </Grid>

                                <!-- Middle: Custom Blocky Usage Progress Track -->
                                <Border Grid.Row="1" Background="#1B1B1B" BorderBrush="#252525" BorderThickness="1" CornerRadius="1" Height="6" HorizontalAlignment="Stretch">
                                    <ProgressBar Value="{x:Bind UsagePercent}" Maximum="100" Height="4" Margin="0" HorizontalAlignment="Stretch" Foreground="{StaticResource AppAccentBrush}" Background="Transparent" />
                                </Border>

                                <!-- Bottom: Used, Free, Percent -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind UsedFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="/" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                        <TextBlock Text="{x:Bind TotalFormatted}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind FreeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Mode Segmented Switcher -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SegmentedModeButtonStyle}" Tag="TreeAnalyzer" Click="OnViewModeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Disk Space Tree Analyzer" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource SegmentedModeButtonStyle}" Tag="Cleanup" Click="OnViewModeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                        <TextBlock Text="System Cleanup &amp; Cache Purge" />
                        <Border Background="#1C1C1C" CornerRadius="1" Padding="4,1">
                            <TextBlock Text="{x:Bind ViewModel.CleanupCandidatesCount, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppSuccessBrush}" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource SegmentedModeButtonStyle}" Tag="LargeFiles" Click="OnViewModeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        <TextBlock Text="Large Files Discovery" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- VIEW 1: DISK SPACE TREE ANALYZER (CORE FEATURE)                            -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{x:Bind ViewModel.IsTreeMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Spacing="12">
                <!-- Navigation & Quick Jump Toolbar -->
                <Border Style="{StaticResource FluentCardStyle}" Padding="12,10">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Up button, Path Breadcrumb, Scan button -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Navigate Up Button -->
                            <Button Grid.Column="0" 
                                    Command="{x:Bind ViewModel.NavigateUpCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanNavigateUp, Mode=OneWay}"
                                    Padding="8,6" 
                                    ToolTipService.ToolTip="Navigate to Parent Folder (Alt+Up)">
                                <FontIcon Glyph="&#xE74A;" FontSize="11" />
                            </Button>

                            <!-- Current Analyzed Path Bar -->
                            <Border Grid.Column="1" Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="2" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentAnalyzedPath, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Include Hidden & System Checkbox -->
                            <CheckBox Grid.Column="2" 
                                      IsChecked="{x:Bind ViewModel.IncludeHiddenAndSystem, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="4,0">
                                <TextBlock Text="Include Hidden &amp; System" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </CheckBox>

                            <!-- Scan Button -->
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.AnalyzeCurrentPathCommand}" Padding="12,6" ToolTipService.ToolTip="Analyze Selected Directory">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing Width="12" Height="12" IsActive="{x:Bind ViewModel.IsTreeScanning, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsTreeScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" Visibility="{x:Bind ViewModel.IsTreeScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="Scan Directory" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Quick Jump Chips & Status Telemetry -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Quick Jump Shortcut Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Quick Jump:" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="Drive Root" Tag="DriveRoot" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="Users" Tag="Users" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="Program Files" Tag="ProgramFiles" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="ProgramData" Tag="ProgramData" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="Windows" Tag="Windows" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="AppData" Tag="AppData" Click="OnQuickJumpClick" />
                                <Button Style="{StaticResource QuickJumpChipStyle}" Content="Temp" Tag="Temp" Click="OnQuickJumpClick" />
                            </StackPanel>

                            <!-- Status text -->
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Storage Tree Table Card -->
                <Border Style="{StaticResource FluentCardStyle}" Padding="0">
                    <ListView ItemsSource="{x:Bind ViewModel.TreeItems, Mode=OneWay}"
                              SelectionMode="Single"
                              DoubleTapped="OnTreeItemDoubleTapped">

                        <!-- Table Header -->
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="16,10" Background="#111111" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="ITEM NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="PROPORTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="CONTENTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="ATTRIBUTES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>

                        <!-- Tree Item Row -->
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StorageFolderItem">
                                <Grid Padding="16,8" DataContext="{x:Bind}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Icon + Name / Path -->
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Background="#16181D" BorderBrush="#262C38" BorderThickness="1" CornerRadius="2" Width="22" Height="22">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="11" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <TextBlock Text="{x:Bind FullPath}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Column 1: Visual Proportion Bar + Percent -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,16,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PercentFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </Grid>
                                        <Border Background="#191919" BorderBrush="#262626" BorderThickness="1" CornerRadius="1" Height="5">
                                            <ProgressBar Value="{x:Bind PercentOfParent}" Maximum="100" Height="3" Background="Transparent" Foreground="{StaticResource AppAccentBrush}" Margin="0" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Column 2: Exact Size -->
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />

                                    <!-- Column 3: Contents / Details -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind DetailsText}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />

                                    <!-- Column 4: System / Hidden Tag Badges -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Background="#1F1A12" BorderBrush="#3B2A18" BorderThickness="1" CornerRadius="2" Padding="5,1"
                                                Visibility="{x:Bind HasTag, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Bind TagText}" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" CharacterSpacing="20" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Column 5: Actions (Drill down & Open in Explorer) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Padding="6,4" ToolTipService.ToolTip="Drill down into folder" Click="OnDrillIntoFolderClick"
                                                Visibility="{x:Bind IsFolder, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" />
                                        </Button>
                                        <Button Padding="6,4" ToolTipService.ToolTip="Open in File Explorer" Click="OnOpenFileLocationClick">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- VIEW 2: SYSTEM CLEANUP & CACHE PURGE                                      -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{x:Bind ViewModel.IsCleanupMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Spacing="12">
                <Border Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="PURGEABLE SYSTEM SCRATCH &amp; CACHES" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CleanupSummaryText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.ToggleSelectAllCleanupCommand}" Padding="10,6">
                                <TextBlock Text="Toggle Select All" FontSize="11" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.RunDryRunSimulationCommand}" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="11" />
                                    <TextBlock Text="Dry-Run Simulation" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExecuteCleanupCommand}" Padding="12,6" BorderBrush="{StaticResource AppSuccessBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                                    <TextBlock Text="Purge Selected Caches" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cleanup Items Table Card -->
                <Border Style="{StaticResource FluentCardStyle}" Padding="0">
                    <ListView ItemsSource="{x:Bind ViewModel.CleanupItems, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CleanupCandidateItem">
                                <Grid Padding="16,10" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{x:Bind SizeFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind ItemCount}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- VIEW 3: LARGE FILES DISCOVERY                                             -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{x:Bind ViewModel.IsLargeFilesMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Spacing="12">
                <Border Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="LARGE FILES REPOSITORY (>50 MB)" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="Locate multi-gigabyte videos, installer archives, and memory dumps across storage volumes." FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.ScanLargeFilesCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing Width="12" Height="12" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon Glyph="&#xE721;" FontSize="11" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="Scan Large Files" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Large Files Table Card -->
                <Border Style="{StaticResource FluentCardStyle}" Padding="0">
                    <ListView ItemsSource="{x:Bind ViewModel.LargeFiles, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LargeFileItem">
                                <Grid Padding="16,10" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FilePath}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeFormatted}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <Button Grid.Column="2" Padding="6,4" ToolTipService.ToolTip="Reveal in File Explorer" Click="OnOpenFileLocationClick" HorizontalAlignment="Right">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.Startup"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Grid Grid.Row="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Page Title & Actions -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="BOOT &amp; AUTORUN CONFIGURATION" Style="{StaticResource MetricLabelTextBlockStyle}" />
                    <TextBlock Text="Startup Applications" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Manage boot persistence vectors, autorun registry entries, and scheduled logon launch hooks." FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- Actions: Live Pill, Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{StaticResource LiveBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AppSuccessBrush}" />
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                        </StackPanel>
                    </Border>

                    <Button Command="{x:Bind ViewModel.RefreshEntriesCommand}" Padding="8,6" ToolTipService.ToolTip="Refresh Startup Apps">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Search & Filter Chips -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <AutoSuggestBox PlaceholderText="Filter startup applications by name, publisher, command...  (Ctrl+F)" 
                                Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Width="360" QueryIcon="Find" />

                <!-- Status Stats Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#141414" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Enabled" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="5,1">
                                <TextBlock Text="{x:Bind ViewModel.EnabledCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#141414" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Disabled" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <Border Background="#1C1C1C" CornerRadius="1" Padding="5,1">
                                <TextBlock Text="{x:Bind ViewModel.DisabledCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppTextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Startup Items List Card -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                      SelectionMode="Single">

                <!-- Table Header -->
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="16,10" Background="#111111" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="APPLICATION &amp; TARGET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="PUBLISHER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="LOCATION VECTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="SCOPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="STARTUP STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <!-- Startup Row ItemTemplate -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupEntry">
                        <Grid Padding="16,10" DataContext="{x:Bind}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Icon + Name / Command -->
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Actual App Icon with Fallback -->
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Image Source="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource FilePathToImage}}" 
                                           Width="20" Height="20"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    
                                    <Border Background="#16181D" BorderBrush="#262C38" BorderThickness="1" CornerRadius="2" Width="20" Height="20"
                                            Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                        <FontIcon Glyph="&#xE7B5;" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    <TextBlock Text="{x:Bind Command}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Column 1: Publisher -->
                            <TextBlock Grid.Column="1" Text="{x:Bind Publisher}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />

                            <!-- Column 2: Location Vector -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Location}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210" />

                            <!-- Column 3: Scope Badge -->
                            <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#161A22" BorderBrush="#242C3D" BorderThickness="1" CornerRadius="2" Padding="6,2">
                                <TextBlock Text="{x:Bind Scope}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" CharacterSpacing="40" />
                            </Border>

                            <!-- Column 4: Toggle Status Switch -->
                            <ToggleSwitch Grid.Column="4" 
                                          IsOn="{x:Bind IsEnabled, Mode=OneWay}" 
                                          Toggled="OnStartupToggleChanged"
                                          Tag="{x:Bind}"
                                          DataContext="{x:Bind}"
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Right"
                                          OnContent="Enabled" OffContent="Disabled" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>

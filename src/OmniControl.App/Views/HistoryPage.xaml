<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OmniControl.Core.Models.History"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- Backup Snapshot Creator Card -->
            <Border Style="{StaticResource FluentCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="SYSTEM CHECKPOINT &amp; BACKUP" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Text="Create a snapshot checkpoint of system settings and environment before making major changes." FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        <TextBox PlaceholderText="Checkpoint Name..." Text="{x:Bind ViewModel.SnapshotName, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CreateCheckpointCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock Text="Save Checkpoint" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Audit History Table -->
            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SYSTEM CHANGE AUDIT LOG" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="All modifications performed through OmniControl are logged locally in SQLite." FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Border Style="{StaticResource LiveBadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" />
                                    <TextBlock Text="Live (2s)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                </StackPanel>
                            </Border>
                            <Button Command="{x:Bind ViewModel.RefreshDataCommand}" ToolTipService.ToolTip="Refresh Audit Log" Padding="8,6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}" MaxHeight="450">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChangeHistoryRecord">
                                <Grid Padding="0,8" BorderBrush="#1E2638" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind Timestamp}" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#1E293B" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{x:Bind ModuleName}" FontSize="11" Foreground="{StaticResource AppAccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind OperationName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind TargetIdentifier}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4" Padding="6,1"
                                            Background="{x:Bind IsSuccess, Converter={StaticResource StateToBrush}}">
                                        <TextBlock Text="{x:Bind Privilege}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>

                                    <Button Grid.Column="4" VerticalAlignment="Center" Click="OnUndoClick"
                                            Visibility="{x:Bind IsReversible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="10" />
                                            <TextBlock Text="Undo" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

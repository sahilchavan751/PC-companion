<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniControl.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:OmniControl.Core.Models.Search"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR — Blocky, flat, no curves ═══ -->
        <!-- ═══ TOP BAR — Clean utility bar, no redundant title/icon ═══ -->
        <Border Grid.Row="0" Background="#0E0E0E" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Global Search Box -->
                <AutoSuggestBox HorizontalAlignment="Left" Width="400"
                                PlaceholderText="Search commands, hardware, settings...  Ctrl+K"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSuggestionChosen"
                                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="search:GlobalSearchResult">
                            <Grid Padding="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="12" Foreground="{StaticResource AppAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Background="#1A1A1A" CornerRadius="1" Padding="5,2" Margin="10,0,0,0">
                                    <TextBlock Text="{x:Bind Category}" FontSize="9" Foreground="{StaticResource AppAccentBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!-- Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Live indicator -->
                    <Border Style="{StaticResource LiveBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AppSuccessBrush}" />
                            <TextBlock Text="LIVE 2s" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" CharacterSpacing="60" />
                        </StackPanel>
                    </Border>

                    <!-- Elevation button -->
                    <Button Command="{x:Bind ViewModel.RequestElevationCommand}" 
                            ToolTipService.ToolTip="Elevate helper process" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7EF;" FontSize="11" 
                                      Foreground="{x:Bind ViewModel.IsRunningAsAdmin, Mode=OneWay, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Text="{x:Bind ViewModel.AdminStatusText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast Notification -->
        <InfoBar Grid.Row="1" 
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                 Severity="Informational" />

        <!-- ═══ NAVIGATION + CONTENT — Minimized by default, hover-expand, no toggle button ═══ -->
        <NavigationView Grid.Row="2" x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="False"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="48"
                        OpenPaneLength="200"
                        IsSettingsVisible="True"
                        PointerMoved="NavView_PointerMoved"
                        PointerExited="NavView_PointerExited"
                        SelectionChanged="OnNavViewSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="Performance" Tag="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Processes" Tag="Processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Services" Tag="Services">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="Hardware" Tag="Hardware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Audio &amp; Display" Tag="AudioDisplay">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Network" Tag="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Storage" Tag="Storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="Startup" Tag="Startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Environment" Tag="Environment">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Security" Tag="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- ═══ BOTTOM STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="16,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="OmniControl v1.0" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                    <TextBlock Text="·" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="WinUI 3 · Fluent" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
            </Grid>
        </Border>

        <!-- ═══ SHIMMER SPLASH SCREEN OVERLAY ═══ -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="4" Canvas.ZIndex="1000" Background="#080808">
            <Grid.Resources>
                <Storyboard x:Name="ShimmerStoryboard" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                                     Storyboard.TargetProperty="X"
                                     EnableDependentAnimation="True"
                                     From="-180" To="480" Duration="0:0:1.4">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="SplashFadeOutStoryboard">
                    <DoubleAnimation Storyboard.TargetName="SplashOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     EnableDependentAnimation="True"
                                     From="1.0" To="0.0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <!-- Center: App Name with Shimmer Effect -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Dim Base Text -->
                <TextBlock Text="OMNICONTROL" FontSize="36" FontWeight="Black" Foreground="#222222" CharacterSpacing="220" HorizontalAlignment="Center" />

                <!-- Shimmer Light Overlay -->
                <Grid HorizontalAlignment="Center">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,140,80">
                            <RectangleGeometry.Transform>
                                <TranslateTransform x:Name="ShimmerTransform" X="-180" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </Grid.Clip>
                    <TextBlock Text="OMNICONTROL" FontSize="36" FontWeight="Black" Foreground="{StaticResource AppAccentBrush}" CharacterSpacing="220" HorizontalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Bottom: Studio Credit -->
            <TextBlock Text="- by Luxvore Studio" 
                       FontSize="11" FontWeight="Normal" Foreground="#666666" 
                       CharacterSpacing="140" 
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                       Margin="0,0,0,36" />
        </Grid>
    </Grid>
</Page>

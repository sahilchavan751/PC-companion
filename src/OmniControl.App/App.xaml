<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OmniControl.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniControl.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:converters="using:OmniControl.App.Converters" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" xmlns:converters="using:OmniControl.App.Converters" />
            <converters:FormatBytesConverter x:Key="FormatBytes" xmlns:converters="using:OmniControl.App.Converters" />
            <converters:StateToBrushConverter x:Key="StateToBrush" xmlns:converters="using:OmniControl.App.Converters" />
            <converters:NullToBoolConverter x:Key="NullToBool" xmlns:converters="using:OmniControl.App.Converters" />
            <converters:FilePathToImageSourceConverter x:Key="FilePathToImage" xmlns:converters="using:OmniControl.App.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
